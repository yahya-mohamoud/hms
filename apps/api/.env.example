NODE_ENV=development
DATABASE_URL="postgresql://hotel:hotel_local_dev@localhost:5432/hotel?schema=public"
PORT=4000
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="12h"
WEB_ORIGIN="http://localhost:5173"
HOTEL_NAME="Your Hotel Name"
ADMIN_EMAIL="admin@local.hotel"
ADMIN_PASSWORD="replace-this-before-seeding"
ADMIN_NAME="Hotel Administrator"

# Optional local MinIO / production Cloudflare R2 configuration.
# Configure all five storage values together before enabling ID image uploads.
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="hotel-private"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="false"
