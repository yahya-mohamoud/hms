generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  RECEPTIONIST
  MANAGER
  HOUSEKEEPING
  ADMIN
}
enum RoomStatus {
  AVAILABLE
  OCCUPIED
  DIRTY
  CLEAN
  INSPECTED
  OUT_OF_ORDER
}
enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}
enum BookingSource {
  WALK_IN
  PHONE
  GROUP
}
enum StayStatus {
  IN_HOUSE
  CHECKED_OUT
}
enum FolioStatus {
  OPEN
  CLOSED
}
enum FolioItemType {
  ROOM_CHARGE
  EXTRA
  TAX
  DISCOUNT
}
enum PaymentMethod {
  CASH
  COOPAY_EBIRR
  EBIRR_KAAFI
  CBE_BANK
  OTHER
  MOBILE_MONEY
  CARD
  BANK_TRANSFER
}
enum ExpenseCategory {
  UTILITIES
  SUPPLIES
  MAINTENANCE
  FOOD
  TRANSPORT
  SALARIES
  TAXES
  OTHER
}
enum HousekeepingStatus {
  OPEN
  IN_PROGRESS
  DONE
}
enum HousekeepingType {
  CLEANING
  INSPECTION
  MAINTENANCE
  SPECIAL_REQUEST
}
enum IdDocumentType {
  NATIONAL_ID
  PASSPORT
  DRIVERS_LICENSE
  OTHER
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  passwordHash  String
  adminRecoveryPhraseHash String?
  role          UserRole     @default(RECEPTIONIST)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  assignedTasks HousekeepingTask[] @relation("TaskAssignee")
  createdTasks  HousekeepingTask[] @relation("TaskCreator")
  activityLogs  ActivityLog[]
  expenses      Expense[]
}

model Room {
  id          String       @id @default(cuid())
  number      String       @unique
  type        String
  floor       Int?
  capacity    Int          @default(2)
  baseRate    Decimal      @db.Decimal(10, 2)
  status      RoomStatus   @default(AVAILABLE)
  notes       String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  stays       Stay[]
  tasks       HousekeepingTask[]
  reservations Reservation[]
  movesFrom  RoomMove[]    @relation("RoomMoveFrom")
  movesTo    RoomMove[]    @relation("RoomMoveTo")
}

model Guest {
  id             String        @id @default(cuid())
  firstName      String
  lastName       String
  phone          String?
  email          String?
  nationality    String?
  idType         IdDocumentType?
  idNumber       String?
  preferences    String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  reservations   Reservation[]
  stays          Stay[]
  documents      GuestDocument[]

  @@index([lastName, firstName])
  @@index([phone])
}

model Reservation {
  id              String            @id @default(cuid())
  confirmationCode String           @unique
  guestId         String
  guest           Guest             @relation(fields: [guestId], references: [id])
  status          ReservationStatus @default(CONFIRMED)
  source          BookingSource     @default(PHONE)
  groupCode       String?
  groupName       String?
  arrivalDate     DateTime          @db.Date
  departureDate   DateTime          @db.Date
  adults          Int               @default(1)
  children        Int               @default(0)
  roomType        String?
  roomId          String?
  room            Room?             @relation(fields: [roomId], references: [id])
  nightlyRate     Decimal           @db.Decimal(10, 2)
  depositAmount   Decimal           @default(0) @db.Decimal(10, 2)
  depositMethod   PaymentMethod     @default(CASH)
  depositReceivedAt DateTime?
  cancellationNote String?
  notes           String?
  createdById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  stay            Stay?

  @@index([arrivalDate, departureDate])
  @@index([status])
  @@index([groupCode])
}

model Stay {
  id             String         @id @default(cuid())
  reservationId  String?        @unique
  reservation    Reservation?   @relation(fields: [reservationId], references: [id])
  guestId        String
  guest          Guest          @relation(fields: [guestId], references: [id])
  roomId         String
  room           Room           @relation(fields: [roomId], references: [id])
  status         StayStatus     @default(IN_HOUSE)
  checkInAt      DateTime       @default(now())
  expectedCheckOut DateTime     @db.Date
  checkOutAt     DateTime?
  nightlyRate    Decimal        @db.Decimal(10, 2)
  adults         Int            @default(1)
  children       Int            @default(0)
  notes          String?
  folio          Folio?
  roomMoves      RoomMove[]

  @@index([guestId, checkOutAt])
  @@index([roomId, status])
}

model RoomMove {
  id          String   @id @default(cuid())
  stayId      String
  stay        Stay     @relation(fields: [stayId], references: [id])
  fromRoomId  String
  fromRoom    Room     @relation("RoomMoveFrom", fields: [fromRoomId], references: [id])
  toRoomId    String
  toRoom      Room     @relation("RoomMoveTo", fields: [toRoomId], references: [id])
  movedAt     DateTime @default(now())
  reason      String?
}

model Folio {
  id          String       @id @default(cuid())
  folioNumber String       @unique
  stayId      String       @unique
  stay        Stay         @relation(fields: [stayId], references: [id])
  status      FolioStatus  @default(OPEN)
  openedAt    DateTime     @default(now())
  closedAt    DateTime?
  items       FolioItem[]
  payments    Payment[]
}

model FolioItem {
  id          String        @id @default(cuid())
  folioId     String
  folio       Folio         @relation(fields: [folioId], references: [id])
  type        FolioItemType
  description String
  quantity    Decimal       @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal       @db.Decimal(10, 2)
  amount      Decimal       @db.Decimal(10, 2)
  postedAt    DateTime      @default(now())
  postedById  String?

  @@index([folioId, postedAt])
}

model Payment {
  id          String        @id @default(cuid())
  folioId     String
  folio       Folio         @relation(fields: [folioId], references: [id])
  method      PaymentMethod
  amount      Decimal       @db.Decimal(10, 2)
  reference   String?
  note        String?
  receivedAt  DateTime      @default(now())
  receivedById String?

  @@index([receivedAt])
}

model Expense {
  id             String          @id @default(cuid())
  category       ExpenseCategory
  description    String
  payee          String?
  amount         Decimal         @db.Decimal(12, 2)
  paymentMethod  PaymentMethod
  reference      String?
  notes          String?
  expenseDate    DateTime        @db.Date
  recordedById   String?
  recordedBy     User?           @relation(fields: [recordedById], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  voidedAt       DateTime?
  voidReason     String?

  @@index([expenseDate, voidedAt])
  @@index([category, expenseDate])
}

model HousekeepingTask {
  id           String            @id @default(cuid())
  roomId       String
  room         Room              @relation(fields: [roomId], references: [id])
  type         HousekeepingType  @default(CLEANING)
  status       HousekeepingStatus @default(OPEN)
  title        String
  notes        String?
  assignedToId String?
  assignedTo   User?             @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdById  String?
  createdBy    User?             @relation("TaskCreator", fields: [createdById], references: [id])
  dueAt        DateTime?
  completedAt  DateTime?
  createdAt    DateTime          @default(now())

  @@index([status, dueAt])
}

model GuestDocument {
  id           String         @id @default(cuid())
  guestId      String
  guest        Guest          @relation(fields: [guestId], references: [id])
  objectKey    String         @unique
  originalName String?
  mimeType     String         @default("image/webp")
  sizeBytes    Int
  documentType IdDocumentType @default(OTHER)
  uploadedById String?
  createdAt    DateTime       @default(now())
}

model DailyAudit {
  id              String   @id @default(cuid())
  businessDate    DateTime @unique @db.Date
  openingRooms    Int
  occupiedRooms   Int
  arrivals        Int
  departures      Int
  roomRevenue     Decimal  @db.Decimal(12, 2)
  otherRevenue    Decimal  @db.Decimal(12, 2)
  paymentsTotal   Decimal  @db.Decimal(12, 2)
  expensesTotal   Decimal  @default(0) @db.Decimal(12, 2)
  netCash         Decimal  @default(0) @db.Decimal(12, 2)
  cashPayments          Decimal  @default(0) @db.Decimal(12, 2)
  coopayEbirrPayments   Decimal  @default(0) @db.Decimal(12, 2)
  ebirrKaafiPayments    Decimal  @default(0) @db.Decimal(12, 2)
  cbeBankPayments       Decimal  @default(0) @db.Decimal(12, 2)
  otherPayments         Decimal  @default(0) @db.Decimal(12, 2)
  mobileMoneyPayments   Decimal  @default(0) @db.Decimal(12, 2)
  cardPayments          Decimal  @default(0) @db.Decimal(12, 2)
  bankTransferPayments  Decimal  @default(0) @db.Decimal(12, 2)
  averageDailyRate      Decimal  @default(0) @db.Decimal(12, 2)
  revenuePerAvailableRoom Decimal @default(0) @db.Decimal(12, 2)
  outstandingTotal      Decimal  @db.Decimal(12, 2)
  closedById      String?
  closedAt        DateTime @default(now())
  notes           String?
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
